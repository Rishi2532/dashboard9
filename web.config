<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.web>
        <!-- Fix 'Improper Error Handling' (Vulnerability #4) -->
        <customErrors mode="On" defaultRedirect="index.html" />
        <!-- Mitigate Banner Grabbing: Suppress X-AspNet-Version header -->
        <httpRuntime enableVersionHeader="false" />
    </system.web>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <!-- Remove X-Powered-By header -->
                <remove name="X-Powered-By" />
                <!-- Fix Vulnerability #7: Content Security Policy (CSP) -->
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://dashboard1.mahajaliot.in;" />
                <!-- Security Hardening: Prevent MIME sniffing -->
                <add name="X-Content-Type-Options" value="nosniff" />
                <!-- Security Hardening: Force HTTPS (HSTS) -->
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
                <!-- Fix Vulnerability #8: Permissions Policy -->
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), usb=(), fullscreen=(self)" />
                <!-- Fix Vulnerability #9: Referrer Policy -->
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <!-- Fix Vulnerability #10: X-Frame-Options -->
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>

        <!-- Suppress verbose IIS error pages -->
        <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
        
        <rewrite>
            <rules>
                <!-- This rule proxies all requests to the PM2/Node process on port 5000 -->
                <rule name="ReverseProxyInboundRule" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:5000/{R:1}" />
                </rule>
            </rules>

            <outboundRules>
                <!-- Remove Server header -->
                <rule name="RemoveServerHeader">
                    <match serverVariable="RESPONSE_SERVER" pattern=".+" />
                    <action type="Rewrite" value="" />
                </rule>
            </outboundRules>
        </rewrite>
    </system.webServer>
</configuration>
